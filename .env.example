# Application
APP_NAME=电商运营助手
APP_ENV=development
APP_DEBUG=true
APP_HOST=127.0.0.1
APP_PORT=8000
APP_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# MySQL: use a dedicated, least-privilege development account
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_NAME=ecommerce_ops
DATABASE_USER=ecommerce_dev
DATABASE_PASSWORD=replace_me
DATABASE_ECHO=false

# Authentication (replace before any shared deployment)
JWT_SECRET=replace_with_a_long_random_value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Text model; MOCK mode is used when the key is empty
LLM_MODEL=mock
LLM_BASE_URL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=60

# Local-first asset storage
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=storage
GENERATION_PROVIDER=dashscope
IMAGE_MODEL=qwen-image-3.0
IMAGE_SIZE=1024x1024
VIDEO_MODEL=wan2.6-t2v

# Async jobs
JOB_MAX_ATTEMPTS=3
JOB_TIMEOUT_SECONDS=900
JOB_POLL_INTERVAL_SECONDS=3
